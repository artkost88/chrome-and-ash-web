# ХРОМ И ПЕПЕЛ — переменные окружения (скопируйте в server/.env и заполните).
# Загружаются автоматически через process.loadEnvFile (Node >= 20.12).

# Порт и адрес прослушивания
HOST=127.0.0.1
PORT=3000

# Путь к файлу SQLite. ":memory:" — для тестов (БД исчезнет при перезапуске).
DB_PATH=./cna.db

# Каталог статического веб-клиента (index.html, js/, style.css). По умолчанию
# — соседний chrome-and-ash-web/. Сервер раздаёт его на том же origin, что и /api.
# CLIENT_DIR=../chrome-and-ash-web

# Каталог движка CnA (data.js/track.js/engine.js/ai.js), который грузит PvP-сервер.
# По умолчанию — соседний chrome-and-ash-web/js.
# ENGINE_DIR=../chrome-and-ash-web/js

# Срок жизни сессии авторизации, дней
SESSION_TTL_DAYS=30

# production включает флаг Secure у session-cookie (нужен HTTPS).
NODE_ENV=development

# PEPPER — серверный секрет, добавляемый к паролю перед scrypt.
# Генерируйте длинную случайную строку:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВАЖНО: менять PEPPER нельзя после того, как созданы аккаунты — иначе пароли перестанут совпадать.
PEPPER=

# --- PvP (фаза 2) ---
# Таймер хода (turnTimerSeconds) и окно возврата после разрыва (rejoinWindowSeconds)
# — НЕ переменные окружения, а параметры лобби в config_json (см. docs/07-pvp-protocol.md).
# Умолчания: таймер 90 с (null = без таймера), окно возврата 300 с. Управляются из
# веб-клиента при создании лобби, отдельных GRACE_MS-подобных env-переменных нет.
